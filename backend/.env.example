# ════════════════════════════════════════════════════════
# DREW KUTTO PHOTOGRAPHY — BACKEND ENVIRONMENT CONFIG
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it contains secrets.
# ════════════════════════════════════════════════════════

# ── SERVER ──
PORT=5000
# Set to 'production' when deploying live
NODE_ENV=development
# CORS: comma-separated frontend origins (leave empty to allow all in dev)
# Example: https://drewkuttophotography.com,https://www.drewkuttophotography.com
FRONTEND_ORIGIN=

# ── DATABASE ──
# Your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/drewkutto?retryWrites=true&w=majority

# ── AUTH ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=8h
# Used by 'npm run seed:admin' to create the initial admin account
ADMIN_USERNAME=drewkutto
ADMIN_PASSWORD=change_this_before_seeding

# ── M-PESA / DARAJA ──
# sandbox = test environment, production = live
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
# Sandbox paybill: 174379 | Production: your actual shortcode
MPESA_SHORTCODE=174379
# Sandbox passkey (fixed), production: from Daraja portal
MPESA_PASSKEY=bfb279f9aa9bdbfc158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# MUST be a public HTTPS URL Safaricom can reach (use ngrok for local testing)
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# ── BUSINESS DEFAULTS (can be overridden in admin panel) ──
DEFAULT_MIN_DAYS_NOTICE=3
DEFAULT_DEPOSIT_PERCENT=50
